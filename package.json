{
  "name": "retro-workbench-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A compact, themeable React workbench starter inspired by Streamweave.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5190",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run check:boundaries && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.11",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
